# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Dynatrace (Phase 0) ---
# Your environment id, the {xxx} in https://{xxx}.apps.dynatrace.com
DT_ENVIRONMENT_NAME=
# Platform Token with: mcp-gateway:servers:invoke, mcp-gateway:servers:read,
# storage:spans:read, storage:logs:read, storage:buckets:read, problems read
DT_PLATFORM_TOKEN=

# --- Dynatrace OTLP ingest (Phase 1) ---
# Access token with scope: openTelemetryTrace.ingest (+ logs.ingest)
DT_OTLP_INGEST_TOKEN=

# --- Google Cloud (Phase 3+) ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
